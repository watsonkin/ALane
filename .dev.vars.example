NEXTJS_ENV=development
# Copy to .dev.vars for local Wrangler. Do not commit .dev.vars.
# Leave these empty. Production secrets are set with Wrangler, not in git:
#   npx wrangler secret put RESEND_API_KEY
#   npx wrangler secret put REMINDERS_UNSUBSCRIBE_SECRET
#   npx wrangler secret put REMINDERS_CRON_SECRET
REMINDERS_ENABLED=0
RESEND_API_KEY=
REMINDERS_UNSUBSCRIBE_SECRET=
REMINDERS_CRON_SECRET=

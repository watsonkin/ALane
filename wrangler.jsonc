{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "alane",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-10-10",
  "compatibility_flags": [
    "nodejs_compat",
    "global_fetch_strictly_public"
  ],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "services": [
    {
      "binding": "WORKER_SELF_REFERENCE",
      "service": "alane"
    }
  ],
  "vars": {
    "REMINDERS_ENABLED": "1",
    "SITE_ORIGIN": "https://alane.photography"
  },
  "d1_databases": [
    {
      "binding": "REMINDERS_DB",
      "database_name": "alane-reminders",
      "database_id": "3de071af-8012-47c6-a460-d8189e5113a8",
      "migrations_dir": "migrations"
    }
  ],
  // CF_WEB_ANALYTICS_TOKEN is intentionally absent. It is a plain worker var, not a secret, and must not be stored in this repo. Set it on the production worker only. Dataset alane_official_outbound is created on the next deploy.
  "analytics_engine_datasets": [
    {
      "binding": "OUTBOUND_CLICKS",
      "dataset": "alane_official_outbound"
    }
  ],
  // 00:15 UTC = 08:15 Asia/Shanghai. Cron stays "15 0 * * *". Digest mail can go out on changes now that REMINDERS_ENABLED is "1".
  "triggers": {
    "crons": ["15 0 * * *"]
  }
}

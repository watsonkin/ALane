{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "alane",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-10-10",
  "compatibility_flags": [
    "nodejs_compat",
    "global_fetch_strictly_public"
  ],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "services": [
    {
      "binding": "WORKER_SELF_REFERENCE",
      "service": "alane"
    }
  ],
  "vars": {
    "REMINDERS_ENABLED": "0",
    "SITE_ORIGIN": "https://alane.photography"
  },
  "d1_databases": [
    {
      "binding": "REMINDERS_DB",
      "database_name": "alane-reminders",
      "database_id": "3de071af-8012-47c6-a460-d8189e5113a8",
      "migrations_dir": "migrations"
    }
  ],
  // 00:15 UTC = 08:15 Asia/Shanghai. Scan runs; digest mail stays off while REMINDERS_ENABLED is "0".
  "triggers": {
    "crons": ["15 0 * * *"]
  }
}

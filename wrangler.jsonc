{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "alane",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-10-10",
  "compatibility_flags": [
    "nodejs_compat",
    "global_fetch_strictly_public"
  ],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "services": [
    {
      "binding": "WORKER_SELF_REFERENCE",
      "service": "alane"
    }
  ],
  // Kill switch. "1" still cannot send while email copy is unconfirmed in code.
  "vars": {
    "REMINDERS_ENABLED": "0"
  },
  "d1_databases": [
    {
      "binding": "REMINDERS_DB",
      "database_name": "alane-reminders",
      // Placeholder until the D1 database is created. Not a secret.
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "migrations"
    }
  ],
  // 00:15 UTC = 08:15 Asia/Shanghai. scheduled POSTs /api/internal/reminders/digest.
  "triggers": {
    "crons": ["15 0 * * *"]
  }
}
